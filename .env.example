# Copy to .env for local dev, or set these in your host's environment.

# Flask session signing key — MUST be a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# Set to 1 only for local debugging. Never in production.
DEBUG=0

# Database. Default is a local SQLite file (pricestalk.db).
# For Postgres later: postgresql+psycopg://user:pass@host:5432/dbname
# DATABASE_URL=sqlite:///pricestalk.db

# Background price re-fetch interval in hours (0 disables it).
REFRESH_HOURS=24
